# Port yang dipakai server Express
PORT=3000

# Nama aplikasi, dikirim ke halaman lewat endpoint /api/info
APP_NAME=Halloworld Express

# Root directory untuk file statis.
# Absolute path dipakai apa adanya; relative path dihitung dari folder index.js.
# Di Windows "/x/b" akan menjadi "C:\x\b".
STATIC_ROOT=/x/b

